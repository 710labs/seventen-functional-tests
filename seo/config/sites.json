{
	"$comment": "Source of truth for the SEO pulse. Adding a site = one entry here. Flipping robotsExpectedState to \"open\" (via PR) switches a site from pre-launch guard to live SEO guard.",
	"defaults": {
		"thresholds": {
			"minTitleLength": 10,
			"maxTitleLength": 60,
			"minMetaDescriptionLength": 50,
			"maxMetaDescriptionLength": 160,
			"minImageWidthForAlt": 40
		},
		"gscClicksCliffPct": 40,
		"gscClicksCliffMinBaseline": 20
	},
	"sites": [
		{
			"id": "live",
			"name": "LIVE - PROD",
			"baseUrl": "https://live.710labs.com",
			"canonicalHost": "live.710labs.com",
			"enabled": true,
			"robotsExpectedState": "blocked",
			"keyPages": ["/shop/", "/strains/", "/learn/"],
			"productListPath": "/shop/",
			"productLinkSelector": "a[href*=\"/product/\"]",
			"productSampleSize": 5,
			"organizationSchemaPages": ["/shop/"],
			"knownIssues": ["single-h1:/shop/", "img-alt:/shop/"],
			"gsc": {
				"property": "sc-domain:710labs.com",
				"pageContains": "live.710labs.com"
			},
			"healthCheckId": "seo-live-prod"
		},
		{
			"id": "live-stage",
			"name": "LIVE - STAGE",
			"baseUrl": "https://live-stage.710labs.com",
			"canonicalHost": "live-stage.710labs.com",
			"enabled": true,
			"robotsExpectedState": "blocked",
			"keyPages": ["/shop/", "/strains/", "/learn/"],
			"productListPath": "/shop/",
			"productLinkSelector": "a[href*=\"/product/\"]",
			"productSampleSize": 5,
			"organizationSchemaPages": ["/shop/"],
			"healthCheckId": "seo-live-stage",
			"knownIssues": []
		},
		{
			"id": "live-dev",
			"name": "LIVE - DEV",
			"baseUrl": "https://live-dev.710labs.com",
			"canonicalHost": "live-dev.710labs.com",
			"enabled": true,
			"robotsExpectedState": "blocked",
			"keyPages": ["/shop/", "/strains/", "/learn/"],
			"productListPath": "/shop/",
			"productLinkSelector": "a[href*=\"/product/\"]",
			"productSampleSize": 5,
			"organizationSchemaPages": ["/shop/"],
			"healthCheckId": "seo-live-dev",
			"knownIssues": []
		},
		{
			"id": "shop",
			"name": "710 Labs Shop",
			"baseUrl": "https://shop.710labs.com",
			"canonicalHost": "shop.710labs.com",
			"enabled": false,
			"robotsExpectedState": "open",
			"keyPages": ["/"],
			"productListPath": "/",
			"productLinkSelector": "a[href*=\"/product\"]",
			"productSampleSize": 5,
			"organizationSchemaPages": ["/"],
			"knownIssues": []
		}
	]
}
